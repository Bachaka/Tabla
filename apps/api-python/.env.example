# apps/api-python/.env.example
#
# Modèle des variables d'environnement de l'API Python. Copie ce fichier en
# « .env » (ignoré par git) et renseigne les vraies valeurs.
# → Le plus simple pour changer de machine : COPIER le .env existant (il contient
#   déjà tous les secrets ci-dessous, synchronisés avec Azure).

# ─── Azure Postgres — compte ADMIN/propriétaire (scripts, migrations) ───
AZURE_PG_HOST=<ton-serveur>.postgres.database.azure.com
AZURE_PG_PORT=5432
AZURE_PG_USER=<utilisateur>
AZURE_PG_PASSWORD=<mot de passe>
AZURE_PG_DATABASE=tabla_dev1
# Azure impose le chiffrement TLS : "require" est l'usage normal.
AZURE_PG_SSL=require

# ─── Auth (JWT) — signature des jetons de connexion ─────────────────────
# Générer une valeur : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<chaîne aléatoire de 64 caractères hex>

# ─── Compte applicatif runtime (SOUMIS à RLS) ───────────────────────────
# Écrit AUTOMATIQUEMENT par `python -m app.scripts.setup_app_role`.
# Ne pas remplir à la main. Si absent, l'API retombe sur le compte admin
# (pratique en dépannage, mais RLS inactif).
# APP_PG_USER=tabla_app
# APP_PG_PASSWORD=<généré par setup_app_role>

# ─── CORS (DÉPLOIEMENT uniquement, pas en dev local) ────────────────────
# URLs des fronts en prod, séparées par des virgules, sans espace ni slash final.
# En dev, laisser vide (même origine via le proxy Vite).
# ALLOWED_ORIGINS=https://convive...,https://admin...,https://resto...
